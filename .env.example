# Supabase Configuration
# When these are configured, MedPulse ERP will sync with your live Supabase database.
# If left empty, the application runs in high-fidelity Demo Mode with mock persistence.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_HOSPITAL_NAME=MedPulse Apex Superspeciality Hospital
VITE_CURRENCY_SYMBOL=$
